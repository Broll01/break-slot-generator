<!DOCTYPE html>
<html lang="bn">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Smart Dynamic Break Slot Generator - Web App</title>

  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>

  <!-- Google Fonts: Inter -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

  <!-- HTML2Canvas Engine for Image Exporting -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>

  <!-- FontAwesome Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', 'sans-serif'],
          },
          colors: {
            brand: {
              50: '#f5f3ff',
              100: '#ede9fe',
              500: '#8b5cf6',
              600: '#7c3aed',
              700: '#6d28d9',
            }
          }
        }
      }
    }
  </script>

  <style>
    /* Custom Scrollbar */
    ::-webkit-scrollbar { width: 8px; height: 8px; }
    ::-webkit-scrollbar-track { background: rgba(0, 0, 0, 0.05); }
    ::-webkit-scrollbar-thumb { background: rgba(139, 92, 246, 0.3); border-radius: 9999px; }
    ::-webkit-scrollbar-thumb:hover { background: rgba(139, 92, 246, 0.6); }

    .glass-card {
      background: rgba(24, 24, 27, 0.75);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border: 1px solid rgba(255, 255, 255, 0.12);
    }
    .light-mode .glass-card {
      background: rgba(255, 255, 255, 0.85);
      border: 1px solid rgba(0, 0, 0, 0.1);
    }

    @keyframes float {
      0% { transform: translate(0, 0) scale(1); }
      100% { transform: translate(40px, 30px) scale(1.15); }
    }
    .orb {
      position: absolute; border-radius: 50%; filter: blur(90px); opacity: 0.25;
      animation: float 14s infinite alternate ease-in-out;
    }
  </style>
</head>

<body class="bg-zinc-950 text-zinc-100 min-h-screen font-sans transition-colors duration-300 relative overflow-x-hidden" id="appBody">

  <!-- Ambient Glowing Orbs -->
  <div class="fixed inset-0 pointer-events-none z-0 overflow-hidden">
    <div class="orb w-96 h-96 bg-purple-600 -top-10 -left-10"></div>
    <div class="orb w-80 h-80 bg-blue-600 -bottom-10 -right-10" style="animation-delay: -5s;"></div>
    <div class="orb w-72 h-72 bg-emerald-600 top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 opacity-15" style="animation-delay: -9s;"></div>
  </div>

  <!-- Main Container -->
  <div class="relative z-10 max-w-4xl mx-auto px-4 py-8 flex flex-col gap-6">

    <!-- Top Navigation Header -->
    <header class="flex flex-wrap items-center justify-between gap-4 pb-2 border-b border-zinc-800">
      <div class="flex items-center gap-3">
        <div class="w-11 h-11 rounded-2xl bg-gradient-to-tr from-purple-600 to-emerald-400 flex items-center justify-center text-white shadow-lg shadow-purple-500/20">
          <i class="fa-solid fa-bolt text-xl"></i>
        </div>
        <div>
          <h1 class="text-xl md:text-2xl font-extrabold tracking-tight bg-gradient-to-r from-purple-400 via-blue-400 to-emerald-400 bg-clip-text text-transparent">
            Smart Break Slot Engine
          </h1>
          <p class="text-xs text-zinc-400 font-medium">LOB Agent Management & Balanced Dynamic Scheduler</p>
        </div>
      </div>

      <div class="flex items-center gap-2">
        <button onclick="toggleTheme()" id="themeBtn" class="px-3.5 py-2 rounded-xl bg-zinc-900/80 hover:bg-zinc-800 border border-zinc-700/60 text-xs font-semibold flex items-center gap-2 transition-all">
          <i class="fa-solid fa-sun text-amber-400"></i> <span>Light Mode</span>
        </button>
      </div>
    </header>

    <!-- Main Config Card -->
    <div class="glass-card rounded-3xl p-6 md:p-8 shadow-2xl flex flex-col gap-6">
      
      <!-- Date & Session Picker -->
      <div>
        <label class="block text-xs font-bold text-zinc-400 uppercase tracking-wider mb-2">
          <i class="fa-regular fa-calendar-days mr-1 text-purple-400"></i> Date & Break Session
        </label>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <select id="dateSelect" class="w-full bg-zinc-900/80 border border-zinc-700/60 text-zinc-200 rounded-xl px-4 py-3 text-sm font-semibold focus:outline-none focus:border-purple-500 transition-all cursor-pointer"></select>
          <select id="sessionTypeSelect" onchange="handleSessionChange()" class="w-full bg-zinc-900/80 border border-zinc-700/60 text-zinc-200 rounded-xl px-4 py-3 text-sm font-semibold focus:outline-none focus:border-purple-500 transition-all cursor-pointer">
            <option value="Morning Break" selected>Morning Break (Default 08:30 AM)</option>
            <option value="Evening Break">Evening Break (Default 05:00 PM)</option>
          </select>
        </div>
      </div>

      <!-- Break Timings & Slots Picker -->
      <div>
        <label class="block text-xs font-bold text-zinc-400 uppercase tracking-wider mb-2">
          <i class="fa-regular fa-clock mr-1 text-blue-400"></i> Start Time, Slot Duration & Count
        </label>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
          <input type="time" id="startTimePicker" value="08:30" class="w-full bg-zinc-900/80 border border-zinc-700/60 text-zinc-200 rounded-xl px-4 py-3 text-sm font-semibold text-center focus:outline-none focus:border-purple-500 transition-all cursor-pointer">
          <select id="slotDurationSelect" class="w-full bg-zinc-900/80 border border-zinc-700/60 text-zinc-200 rounded-xl px-4 py-3 text-sm font-semibold text-center focus:outline-none focus:border-purple-500 transition-all cursor-pointer">
            <option value="15">15 Minutes Slot</option>
            <option value="30" selected>30 Minutes Slot</option>
