        </div>

        <!-- CRUD Management Drawer -->
        <div id="managerBox" class="hidden flex-col gap-4 bg-zinc-900/90 border border-zinc-700/80 p-5 rounded-2xl mb-4 transition-all">
          
          <!-- 1. Department Operations -->
          <div class="bg-zinc-800/40 p-3.5 rounded-xl border border-zinc-700/40">
            <span class="block text-xs font-bold text-blue-400 uppercase tracking-wider mb-2">
              <i class="fa-solid fa-folder-plus mr-1"></i> Department Operations
            </span>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-2">
              <div class="flex gap-2">
                <input type="text" id="newDeptName" placeholder="New Dept Name (e.g. VIP Support)" class="flex-1 bg-zinc-900 border border-zinc-700 text-xs rounded-xl px-3 py-2 text-zinc-200 focus:outline-none focus:border-purple-500">
                <button onclick="addNewDeptUI()" class="bg-blue-600 hover:bg-blue-500 text-white font-bold text-xs px-3 py-2 rounded-xl transition-all flex items-center gap-1">
