            </span>
            <div class="flex flex-wrap sm:flex-nowrap items-center gap-2">
              <select id="transferAgentSelect" class="flex-1 bg-zinc-900 border border-zinc-700 text-xs rounded-xl px-3 py-2 text-zinc-200 focus:outline-none focus:border-purple-500"></select>
              <i class="fa-solid fa-arrow-right text-zinc-500 hidden sm:inline"></i>
              <select id="transferDeptSelect" class="flex-1 bg-zinc-900 border border-zinc-700 text-xs rounded-xl px-3 py-2 text-zinc-200 focus:outline-none focus:border-purple-500"></select>
              <button onclick="transferAgentUI()" class="bg-purple-600 hover:bg-purple-500 text-white font-bold text-xs px-4 py-2 rounded-xl transition-all flex items-center gap-1">
                <i class="fa-solid fa-arrows-rotate"></i> Transfer
              </button>
            </div>
