          </h3>
          <span id="agentCountBadge" class="bg-purple-600/90 text-white font-bold text-xs px-3 py-1 rounded-full shadow-sm">
            Total Agents: 0
          </span>
        </div>

        <!-- Overall Department Count Badges -->
        <div class="mb-4">
          <label class="block text-xs font-bold text-zinc-400 uppercase tracking-wider mb-2">Department Total Breakdown</label>
          <div id="breakdownContainer" class="flex flex-wrap gap-2 p-3 rounded-xl bg-zinc-950/60 border border-zinc-800"></div>
        </div>

        <!-- Matrix Breakdown Table -->
        <div class="mb-4">
          <label class="block text-xs font-bold text-zinc-400 uppercase tracking-wider mb-2">Slot-wise Department Breakdown</label>
          <div id="slotMatrixContainer" class="overflow-x-auto rounded-xl border border-zinc-800"></div>
        </div>

        <!-- Text Roster Pre Output -->
        <div>
          <label class="block text-xs font-bold text-zinc-400 uppercase tracking-wider mb-2">Final Printable Schedule</label>
          <pre id="outputResult" class="p-4 rounded-xl bg-zinc-950/90 border border-zinc-800 text-zinc-200 font-mono text-xs leading-relaxed whitespace-pre-wrap max-h-96 overflow-y-auto"></pre>
        </div>
      </div>

      <!-- Search Input Filter -->
      <div>
        <input type="text" id="agentSearch" onkeyup="filterSchedule()" placeholder="🔍 Quick search agent name in output..." class="w-full bg-zinc-900/90 border border-zinc-700/60 rounded-xl px-4 py-2.5 text-xs font-medium text-zinc-200 focus:outline-none focus:border-purple-500">
      </div>

      <!-- Output Export Action Buttons -->
      <div class="flex flex-wrap gap-3">
        <button onclick="copyText()" class="flex-1 min-w-[130px] py-3 px-4 rounded-xl bg-blue-600 hover:bg-blue-500 text-white font-bold text-xs transition-all shadow-md flex items-center justify-center gap-2">
          <i class="fa-regular fa-copy"></i> <span>Copy Text</span>
        </button>
        <button onclick="downloadText()" class="flex-1 min-w-[130px] py-3 px-4 rounded-xl bg-amber-600 hover:bg-amber-500 text-white font-bold text-xs transition-all shadow-md flex items-center justify-center gap-2">
          <i class="fa-solid fa-download"></i> <span>Download .txt</span>
        </button>
        <button onclick="exportToImage()" class="flex-1 min-w-[130px] py-3 px-4 rounded-xl bg-purple-600 hover:bg-purple-500 text-white font-bold text-xs transition-all shadow-md flex items-center justify-center gap-2">
          <i class="fa-regular fa-image"></i> <span>Export PNG Card</span>
        </button>
      </div>

    </div>

  </div>

  <!-- Toast Notification -->
  <div id="toast" class="fixed bottom-6 left-1/2 transform -translate-x-1/2 bg-zinc-100 text-zinc-900 px-6 py-3 rounded-full font-bold text-xs shadow-2xl transition-all duration-300 opacity-0 pointer-events-none z-50 flex items-center gap-2">
    <i class="fa-solid fa-circle-check text-emerald-600"></i>
    <span id="toastMsg">Notification message</span>
  </div>

  <script>
    // Default Agent Roster Data
    const DEFAULT_AGENT_TEXT = `Message Team
