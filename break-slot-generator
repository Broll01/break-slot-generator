          <select id="slotCountSelect" class="w-full bg-zinc-900/80 border border-zinc-700/60 text-zinc-200 rounded-xl px-4 py-3 text-sm font-semibold text-center focus:outline-none focus:border-purple-500 transition-all cursor-pointer">
