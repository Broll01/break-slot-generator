        </div>

        <!-- Main Editable Raw Text Area -->
        <textarea id="agentData" oninput="saveToLocal()" placeholder="Paste or edit agent roster here..." class="w-full h-44 bg-zinc-900/90 border border-zinc-700/60 rounded-2xl p-4 text-xs font-mono text-zinc-200 focus:outline-none focus:border-purple-500 transition-all leading-relaxed"></textarea>
      </div>

      <!-- Action Button -->
      <button onclick="generateSchedule()" class="w-full py-4 rounded-2xl bg-gradient-to-r from-emerald-500 via-teal-600 to-blue-600 hover:from-emerald-400 hover:to-blue-500 text-white font-extrabold text-sm tracking-wide shadow-lg shadow-emerald-600/20 active:scale-[0.99] transition-all flex items-center justify-center gap-2">
        <i class="fa-solid fa-wand-magic-sparkles"></i> <span>Generate Equal & Randomized Schedule</span>
      </button>

    </div>

    <!-- Output Display Card -->
    <div id="outputCard" class="hidden glass-card rounded-3xl p-6 md:p-8 shadow-2xl flex-col gap-6">
      
      <!-- Exportable Capture Area -->
      <div id="exportableArea" class="p-4 rounded-2xl bg-zinc-900/60 border border-zinc-800">
        
        <div class="flex items-center justify-between pb-3 mb-4 border-b border-zinc-800">
          <h3 class="text-sm font-bold text-zinc-300 uppercase tracking-wider flex items-center gap-2">
