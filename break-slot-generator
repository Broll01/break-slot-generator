    // Senior Agent List for Balance Preservation
    const SENIOR_AGENTS = [
      "Md. Lehadujjaman", "Md Amir Hossen", "Md Zihad Hossain",
      "Ujjal Ullah Papon", "Alifur Rahman", 
      "Rezaul Hossain Rakib", "MD. Tasin Hossain Hawlader Rinku", 
      "Md Aminul islam", "Md Irfan Ahmed",
      "Md Fardin Hasan", "Seaim Rahman", "Rafid Bin Karim"
    ].map(s => s.trim().toLowerCase());

    let fullGeneratedText = "";

    window.onload = function() {
      populateDateDropdown();
      loadTheme();
      const savedData = localStorage.getItem("savedAgentData_WebApp_v1");
      if (savedData) {
        document.getElementById("agentData").value = savedData;
      } else {
        loadDefaultData();
      }
      syncManagementDropdowns();
    };

    function saveToLocal() {
      localStorage.setItem("savedAgentData_WebApp_v1", document.getElementById("agentData").value);
      syncManagementDropdowns();
    }
    
    function loadDefaultData() {
      document.getElementById("agentData").value = DEFAULT_AGENT_TEXT;
      saveToLocal();
      showToast("Default roster loaded successfully!");
    }

    function toggleManagerBox() {
      const box = document.getElementById("managerBox");
      if (box.classList.contains("hidden")) {
        box.classList.remove("hidden");
        box.classList.add("flex");
        syncManagementDropdowns();
      } else {
        box.classList.add("hidden");
        box.classList.remove("flex");
      }
    }

    // Robust Parser
    function parseStructure() {
      const text = document.getElementById("agentData").value;
      const lines = text.split('\n');
      const data = {};
      let currentDept = null;

      lines.forEach(line => {
        const trimmed = line.trim();
        if (!trimmed) return;
        
        // Strict identification of agent names vs department headers
        const isAgent = trimmed.startsWith("Md.") || trimmed.startsWith("MD.") || 
                        (trimmed.split(' ').length >= 2 && 
                         !trimmed.toLowerCase().includes("team") && 
                         !trimmed.toLowerCase().includes("call") && 
                         !trimmed.toLowerCase().includes("web") && 
                         !trimmed.toLowerCase().includes("qmt") && 
                         !trimmed.toLowerCase().includes("recell") && 
                         !trimmed.toLowerCase().includes("order") && 
                         !trimmed.toLowerCase().includes("review") && 
                         !trimmed.toLowerCase().includes("mart") && 
                         !trimmed.toLowerCase().includes("support"));

        if (!isAgent && trimmed.length < 35 && !trimmed.includes(",")) {
          currentDept = trimmed;
          if (!data[currentDept]) data[currentDept] = [];
        } else {
          // If no department header was specified yet, assign to first found header or prompt
          if (!currentDept) {
            currentDept = "Unassigned Department";
            data[currentDept] = [];
          }
          if (!data[currentDept]) data[currentDept] = [];
          data[currentDept].push(trimmed);
        }
      });
      return data;
    }

    function stringifyStructure(dataObj) {
      let result = "";
      Object.keys(dataObj).forEach(dept => {
        result += `${dept}\n`;
        dataObj[dept].forEach(agent => {
          result += `${agent}\n`;
        });
        result += `\n`;
      });
      return result.trim();
    }

    function syncManagementDropdowns() {
      const dataObj = parseStructure();
      const depts = Object.keys(dataObj);
      let allAgents = [];

      const targetDeptSelect = document.getElementById("targetDeptSelect");
      const removeDeptSelect = document.getElementById("removeDeptSelect");
      const transferDeptSelect = document.getElementById("transferDeptSelect");

      targetDeptSelect.innerHTML = "";
      removeDeptSelect.innerHTML = "";
      transferDeptSelect.innerHTML = "";

      depts.forEach(d => {
        targetDeptSelect.innerHTML += `<option value="${d}">${d}</option>`;
        removeDeptSelect.innerHTML += `<option value="${d}">${d}</option>`;
        transferDeptSelect.innerHTML += `<option value="${d}">${d}</option>`;

        if (dataObj[d]) {
          dataObj[d].forEach(a => {
            allAgents.push({ name: a, dept: d });
          });
        }
      });

      const removeAgentSelect = document.getElementById("removeAgentSelect");
      const transferAgentSelect = document.getElementById("transferAgentSelect");

      removeAgentSelect.innerHTML = "";
      transferAgentSelect.innerHTML = "";

      allAgents.forEach(item => {
        removeAgentSelect.innerHTML += `<option value="${item.name}">${item.name} (${item.dept})</option>`;
        transferAgentSelect.innerHTML += `<option value="${item.name}">${item.name} (${item.dept})</option>`;
      });
    }

    function addNewDeptUI() {
      const newDept = document.getElementById("newDeptName").value.trim();
      if (!newDept) { alert("Please enter department name!"); return; }
      const dataObj = parseStructure();
      if (dataObj[newDept]) { alert("Department already exists!"); return; }
      
      dataObj[newDept] = [];
      document.getElementById("agentData").value = stringifyStructure(dataObj);
      saveToLocal();
      document.getElementById("newDeptName").value = "";
      showToast(`Added department: ${newDept}`);
    }

    function removeDeptUI() {
      const deptToRemove = document.getElementById("removeDeptSelect").value;
      if (!deptToRemove) return;

      if (confirm(`Are you sure you want to delete "${deptToRemove}" and all its agents?`)) {
        const dataObj = parseStructure();
        delete dataObj[deptToRemove];

        document.getElementById("agentData").value = stringifyStructure(dataObj);
        saveToLocal();
        showToast(`Removed department: ${deptToRemove}`);
      }
    }

    function addNewAgentUI() {
      const name = document.getElementById("newAgentName").value.trim();
      const dept = document.getElementById("targetDeptSelect").value;
      if (!name) { alert("Please enter agent name!"); return; }
      
      const dataObj = parseStructure();
      if (!dataObj[dept]) dataObj[dept] = [];
      dataObj[dept].push(name);

      document.getElementById("agentData").value = stringifyStructure(dataObj);
      saveToLocal();
      document.getElementById("newAgentName").value = "";
      showToast(`Added ${name} to ${dept}!`);
    }

    function removeAgentUI() {
      const agentToRemove = document.getElementById("removeAgentSelect").value;
      if (!agentToRemove) return;

      const dataObj = parseStructure();
      Object.keys(dataObj).forEach(dept => {
        dataObj[dept] = dataObj[dept].filter(a => a !== agentToRemove);
      });

      document.getElementById("agentData").value = stringifyStructure(dataObj);
      saveToLocal();
      showToast(`Removed agent: ${agentToRemove}`);
    }

    function transferAgentUI() {
      const agentToMove = document.getElementById("transferAgentSelect").value;
      const targetDept = document.getElementById("transferDeptSelect").value;
      if (!agentToMove || !targetDept) return;

      const dataObj = parseStructure();
      
      Object.keys(dataObj).forEach(dept => {
        dataObj[dept] = dataObj[dept].filter(a => a !== agentToMove);
      });

      if (!dataObj[targetDept]) dataObj[targetDept] = [];
      dataObj[targetDept].push(agentToMove);

      document.getElementById("agentData").value = stringifyStructure(dataObj);
      saveToLocal();
      showToast(`Transferred ${agentToMove} to ${targetDept}!`);
    }

    function handleSessionChange() {
      const session = document.getElementById("sessionTypeSelect").value;
      const timePicker = document.getElementById("startTimePicker");
      timePicker.value = (session === "Morning Break") ? "08:30" : "17:00";
    }

    function populateDateDropdown() {
      const dateSelect = document.getElementById("dateSelect");
      const months = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
      const today = new Date();
      for (let i = 0; i < 7; i++) {
        const nextDate = new Date();
        nextDate.setDate(today.getDate() + i);
        const formattedDate = `${nextDate.getDate()} ${months[nextDate.getMonth()]}`;
        const option = document.createElement("option");
        option.value = formattedDate;
        option.textContent = i === 0 ? `${formattedDate} (Today)` : (i === 1 ? `${formattedDate} (Tomorrow)` : formattedDate);
        dateSelect.appendChild(option);
      }
    }

    function loadTheme() {
      const isLight = localStorage.getItem("theme") === "light";
      if (isLight) {
        document.documentElement.classList.remove('dark');
        document.body.classList.add("light-mode", "bg-slate-100", "text-zinc-900");
        document.body.classList.remove("bg-zinc-950", "text-zinc-100");
        document.getElementById("themeBtn").innerHTML = `<i class="fa-solid fa-moon text-indigo-500"></i> <span>Dark Mode</span>`;
      } else {
        document.documentElement.classList.add('dark');
        document.body.classList.remove("light-mode", "bg-slate-100", "text-zinc-900");
        document.body.classList.add("bg-zinc-950", "text-zinc-100");
        document.getElementById("themeBtn").innerHTML = `<i class="fa-solid fa-sun text-amber-400"></i> <span>Light Mode</span>`;
      }
    }

    function toggleTheme() {
      const isLight = document.body.classList.contains("light-mode");
      localStorage.setItem("theme", isLight ? "dark" : "light");
      loadTheme();
    }

    function showToast(msg) {
      const toast = document.getElementById("toast");
      document.getElementById("toastMsg").textContent = msg;
      toast.classList.remove("opacity-0", "pointer-events-none");
      toast.classList.add("opacity-100");
      setTimeout(() => {
        toast.classList.remove("opacity-100");
        toast.classList.add("opacity-0", "pointer-events-none");
      }, 2500);
    }

    function formatMinsTo12Hr(totalMins) {
      totalMins = totalMins % (24 * 60);
      if (totalMins < 0) totalMins += 24 * 60;
      let hours = Math.floor(totalMins / 60);
      let mins = totalMins % 60;
      let ampm = hours >= 12 ? 'PM' : 'AM';
      hours = hours % 12;
      hours = hours ? hours : 12;
      let minStr = mins < 10 ? '0' + mins : mins;
      return `${hours}:${minStr}${ampm}`;
    }

    function shuffleArray(array) {
      for (let i = array.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [array[i], array[j]] = [array[j], array[i]];
      }
      return array;
    }

    function generateSchedule() {
      const dateStr = document.getElementById("dateSelect").value;
      const sessionType = document.getElementById("sessionTypeSelect").value;
      const rawText = document.getElementById("agentData").value;

      if (!rawText.trim()) {
        showToast("Please enter or paste an agent list!");
        return;
      }

      const timeVal = document.getElementById("startTimePicker").value;
      if (!timeVal) {
        alert("Please select a valid start time!");
        return;
      }

      const [h, m] = timeVal.split(':').map(Number);
      let startTotalMins = h * 60 + m;
      const slotDuration = parseInt(document.getElementById("slotDurationSelect").value, 10);
      const totalSlotCount = parseInt(document.getElementById("slotCountSelect").value, 10);

      let slotLabels = [];
      let curr = startTotalMins;
      for (let i = 0; i < totalSlotCount; i++) {
        let next = curr + slotDuration;
        slotLabels.push(`${formatMinsTo12Hr(curr)}-${formatMinsTo12Hr(next)}`);
        curr = next;
      }

      const lobData = parseStructure();
      const slotBuckets = Array.from({ length: totalSlotCount }, () => []);
      let slotDeptMatrix = {};
      let totalAgentsCount = 0;
      let departmentCounts = {};

      Object.keys(lobData).forEach(lob => {
        const agents = lobData[lob];
        if (!agents || agents.length === 0) return;
        
        departmentCounts[lob] = agents.length;
        slotDeptMatrix[lob] = Array(totalSlotCount).fill(0);
        
        const seniorsInLob = [];
        const regularsInLob = [];

        agents.forEach(agent => {
          totalAgentsCount++;
          const cleanName = agent.toLowerCase();
          if (SENIOR_AGENTS.some(s => cleanName === s || cleanName.includes(s))) {
            seniorsInLob.push(agent);
          } else {
            regularsInLob.push(agent);
          }
        });

        shuffleArray(seniorsInLob);
        shuffleArray(regularsInLob);

        let randomOffset = Math.floor(Math.random() * totalSlotCount);
        seniorsInLob.forEach((agent, index) => { 
          let slotIdx = (index + randomOffset) % totalSlotCount;
          slotBuckets[slotIdx].push(agent); 
          slotDeptMatrix[lob][slotIdx]++;
        });
        
        let randomOffsetReg = Math.floor(Math.random() * totalSlotCount);
        regularsInLob.forEach((agent, index) => { 
          let slotIdx = (index + randomOffsetReg) % totalSlotCount;
          slotBuckets[slotIdx].push(agent); 
          slotDeptMatrix[lob][slotIdx]++;
        });
      });

      // Overall Department Badges
      let breakdownHTML = "";
      Object.keys(departmentCounts).forEach(lob => {
        breakdownHTML += `<span class="bg-zinc-800 border border-zinc-700/60 text-zinc-300 font-medium px-2.5 py-1 rounded-lg text-xs">${lob}: <strong class="text-purple-400 font-bold">${departmentCounts[lob]}</strong></span>`;
      });
      document.getElementById("breakdownContainer").innerHTML = breakdownHTML;

      // Matrix Table Output
      let tableHTML = `
        <table class="w-full text-xs text-center border-collapse bg-zinc-950/80">
          <thead>
            <tr class="bg-zinc-800/60 text-blue-400 font-bold border-b border-zinc-800">
              <th class="p-2.5 text-left border-r border-zinc-800">Department</th>`;
      
      slotLabels.forEach((label, idx) => {
        tableHTML += `<th class="p-2.5 border-r border-zinc-800">Slot ${idx + 1}<br><span class="text-[10px] text-zinc-400 font-normal">${label}</span></th>`;
      });

      tableHTML += `<th class="p-2.5">Total</th></tr></thead><tbody>`;

      let slotTotals = Array(totalSlotCount).fill(0);
      let grandTotal = 0;

      Object.keys(slotDeptMatrix).forEach(lob => {
        let counts = slotDeptMatrix[lob];
        let deptTotal = counts.reduce((a, b) => a + b, 0);
        grandTotal += deptTotal;

        tableHTML += `<tr class="border-b border-zinc-800/60"><td class="p-2.5 text-left font-semibold text-zinc-200 border-r border-zinc-800">${lob}</td>`;
        counts.forEach((c, idx) => {
          slotTotals[idx] += c;
          tableHTML += `<td class="p-2.5 font-bold text-emerald-400 border-r border-zinc-800">${c}</td>`;
        });
        tableHTML += `<td class="p-2.5 font-bold text-blue-400">${deptTotal}</td></tr>`;
      });

      tableHTML += `<tr class="bg-blue-950/30 font-bold text-blue-400"><td class="p-2.5 text-left border-r border-zinc-800">Total Slot Agents</td>`;
      slotTotals.forEach(st => {
        tableHTML += `<td class="p-2.5 border-r border-zinc-800">${st}</td>`;
      });
      tableHTML += `<td class="p-2.5 text-purple-400">${grandTotal}</td></tr>`;

      tableHTML += `</tbody></table>`;
      document.getElementById("slotMatrixContainer").innerHTML = tableHTML;

      // Text Output Generation
      let resultText = `*${dateStr} ${sessionType} (${slotDuration}min Break Slot)*\n*No Swap Allowed*\n\n`;

      slotLabels.forEach((slotLabel, index) => {
        resultText += `${slotLabel}\n\n`;
        if (slotBuckets[index].length > 0) {
          resultText += slotBuckets[index].join("\n");
        } else {
          resultText += "No agents assigned";
        }
        resultText += `\n\n`;
      });

      fullGeneratedText = resultText.trim();
      document.getElementById("outputResult").textContent = fullGeneratedText;
      document.getElementById("agentCountBadge").textContent = `Total Agents: ${totalAgentsCount}`;
      document.getElementById("agentSearch").value = "";
      
      const outputCard = document.getElementById("outputCard");
      outputCard.classList.remove("hidden");
      outputCard.classList.add("flex");
      setTimeout(() => outputCard.scrollIntoView({ behavior: 'smooth', block: 'start' }), 100);
      
      showToast("Break Schedule Generated Successfully!");
    }

    function filterSchedule() {
      const query = document.getElementById("agentSearch").value.toLowerCase();
      if (!query) {
        document.getElementById("outputResult").textContent = fullGeneratedText;
        return;
      }

      const lines = fullGeneratedText.split('\n');
      const filteredLines = lines.filter(line => {
        if (line.includes("*") || line.includes("M") || line.includes("AM") || line.includes("PM") || line.trim() === "") return true;
        return line.toLowerCase().includes(query);
      });

      document.getElementById("outputResult").textContent = filteredLines.join('\n');
    }

    function copyText() {
      const temp = document.createElement("textarea");
      temp.value = document.getElementById("outputResult").textContent;
      document.body.appendChild(temp);
      temp.select();
      document.execCommand("copy");
      document.body.removeChild(temp);
      showToast("Text Copied to Clipboard!");
    }

    function downloadText() {
      const text = document.getElementById("outputResult").textContent;
      const dateStr = document.getElementById("dateSelect").value.replace(/\s+/g, '_');
      const sessionType = document.getElementById("sessionTypeSelect").value.replace(/\s+/g, '_');
      const filename = `${dateStr}_${sessionType}_Break_Schedule.txt`;

      const blob = new Blob([text], { type: 'text/plain' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = filename;
      a.click();
      URL.revokeObjectURL(url);
      showToast("Text File Downloaded!");
    }

    function exportToImage() {
      const exportArea = document.getElementById("exportableArea");
      showToast("Generating Image Card...");
      
      html2canvas(exportArea, {
        backgroundColor: "#09090b",
        scale: 2
      }).then(canvas => {
        const link = document.createElement("a");
        const dateStr = document.getElementById("dateSelect").value.replace(/\s+/g, '_');
        link.download = `${dateStr}_Break_Schedule.png`;
        link.href = canvas.toDataURL("image/png");
        link.click();
        showToast("PNG Image Exported!");
      }).catch(err => {
        showToast("Image export failed.");
      });
    }
  </script>

