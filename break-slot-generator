                <button onclick="addNewAgentUI()" class="bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs px-3 py-2 rounded-xl transition-all flex items-center gap-1">
                  <i class="fa-solid fa-plus"></i> Add
